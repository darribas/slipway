{
  "name": "slipway-cli",
  "version": "0.1.0",
  "description": "Render Quarto-flavoured reveal.js decks (.qmd) to a single self-contained HTML file, fully offline. Same renderer as the Slipway PWA.",
  "license": "MIT",
  "homepage": "https://darribas.github.io/slipway/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darribas/slipway.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "slipway": "dist/slipway.mjs"
  },
  "files": [
    "dist/slipway.mjs",
    "dist/pandoc.wasm",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen-assets": "npm --prefix ../core run gen-assets",
    "prebuild": "npm run gen-assets",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "pretypecheck": "npm run gen-assets",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@slipway/core": "file:../core",
    "@types/node": "^25.8.0",
    "esbuild": "^0.25.0",
    "pandoc-wasm": "1.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.6"
  }
}
