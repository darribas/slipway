{
  "name": "slipway",
  "displayName": "Slipway",
  "description": "Preview and export Quarto-flavoured reveal.js decks (.qmd) \u2014 rendered locally in the editor, offline once loaded. Same renderer as the Slipway PWA.",
  "version": "0.1.0",
  "publisher": "darribas",
  "license": "MIT",
  "homepage": "https://darribas.github.io/slipway/",
  "repository": {
    "type": "git",
    "url": "https://github.com/darribas/slipway.git",
    "directory": "vscode"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "quarto",
    "revealjs",
    "slides",
    "presentation",
    "pandoc"
  ],
  "browser": "./dist/extension.js",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:quarto",
    "onWebviewPanel:slipway.preview"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "quarto",
        "aliases": [
          "Quarto",
          "quarto"
        ],
        "extensions": [
          ".qmd"
        ]
      }
    ],
    "commands": [
      {
        "command": "slipway.previewToSide",
        "title": "Open Preview to the Side",
        "category": "Slipway",
        "icon": "$(open-preview)"
      },
      {
        "command": "slipway.preview",
        "title": "Open Preview",
        "category": "Slipway"
      },
      {
        "command": "slipway.render",
        "title": "Render",
        "category": "Slipway",
        "icon": "$(refresh)"
      },
      {
        "command": "slipway.exportHtml",
        "title": "Export HTML",
        "category": "Slipway"
      },
      {
        "command": "slipway.exportPrintHtml",
        "title": "Export Print HTML",
        "category": "Slipway"
      },
      {
        "command": "slipway.toggleSync",
        "title": "Toggle Cursor Sync",
        "category": "Slipway",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "slipway.previewToSide",
          "when": "editorLangId == quarto",
          "group": "navigation"
        },
        {
          "command": "slipway.render",
          "when": "activeWebviewPanelId == 'slipway.preview'",
          "group": "navigation@1"
        },
        {
          "command": "slipway.toggleSync",
          "when": "activeWebviewPanelId == 'slipway.preview'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "slipway.previewToSide",
          "when": "editorLangId == quarto"
        },
        {
          "command": "slipway.preview",
          "when": "editorLangId == quarto"
        },
        {
          "command": "slipway.exportHtml",
          "when": "editorLangId == quarto || activeWebviewPanelId == 'slipway.preview'"
        },
        {
          "command": "slipway.exportPrintHtml",
          "when": "editorLangId == quarto || activeWebviewPanelId == 'slipway.preview'"
        }
      ],
      "editor/context": [
        {
          "command": "slipway.exportHtml",
          "when": "resourceExtname == .qmd",
          "group": "slipway"
        }
      ],
      "explorer/context": [
        {
          "command": "slipway.exportHtml",
          "when": "resourceExtname == .qmd",
          "group": "slipway"
        }
      ]
    },
    "configuration": {
      "title": "Slipway",
      "properties": {
        "slipway.renderOn": {
          "type": "string",
          "enum": [
            "save",
            "manual",
            "type"
          ],
          "enumDescriptions": [
            "Re-render open previews when a file in the deck's project is saved.",
            "Render only when the Slipway: Render command is run.",
            "Re-render while typing, after slipway.debounceMs of quiet."
          ],
          "default": "save",
          "description": "When open previews are re-rendered."
        },
        "slipway.debounceMs": {
          "type": "number",
          "default": 1000,
          "minimum": 200,
          "description": "With renderOn: \"type\", how long to wait after the last keystroke before rendering. A render takes about 1.5 s, so lower values mostly queue work."
        },
        "slipway.syncCursor": {
          "type": "boolean",
          "default": true,
          "description": "Move the preview to the slide under the editor cursor."
        },
        "slipway.exportPath": {
          "type": "string",
          "default": "${fileDirname}/${fileBasenameNoExtension}.html",
          "description": "Where Export HTML writes. Supports ${fileDirname}, ${fileBasename}, ${fileBasenameNoExtension}, ${fileExtname} and ${workspaceFolder}; a relative path is relative to the deck's folder."
        },
        "slipway.projectRoot": {
          "type": "string",
          "default": "",
          "description": "The folder searched for the deck's theme, bibliography, images, fonts and includes. Empty means the workspace folder that contains the deck. A relative path is relative to that workspace folder."
        }
      }
    }
  },
  "scripts": {
    "gen-assets": "npm --prefix ../core run gen-assets",
    "prebuild": "npm run gen-assets",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "pretypecheck": "npm run gen-assets",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@slipway/core": "file:../core",
    "@types/node": "^25.8.0",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.25.0",
    "pandoc-wasm": "1.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.6",
    "vscode-uri": "^3.0.8"
  }
}
