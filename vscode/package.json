{
  "name": "slipway",
  "displayName": "Slipway",
  "description": "Preview and export Quarto-flavoured reveal.js decks (.qmd) — rendered locally in the editor, offline once loaded. Same renderer as the Slipway PWA.",
  "version": "0.1.0",
  "publisher": "darribas",
  "license": "MIT",
  "homepage": "https://darribas.github.io/slipway/",
  "repository": {
    "type": "git",
    "url": "https://github.com/darribas/slipway.git",
    "directory": "vscode"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "quarto",
    "revealjs",
    "slides",
    "presentation",
    "pandoc"
  ],
  "browser": "./dist/extension.js",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:quarto",
    "onWebviewPanel:slipway.preview"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "quarto",
        "aliases": [
          "Quarto",
          "quarto"
        ],
        "extensions": [
          ".qmd"
        ]
      }
    ],
    "commands": [
      {
        "command": "slipway.previewToSide",
        "title": "Open Preview to the Side",
        "category": "Slipway",
        "icon": "$(open-preview)"
      },
      {
        "command": "slipway.preview",
        "title": "Open Preview",
        "category": "Slipway"
      },
      {
        "command": "slipway.render",
        "title": "Render",
        "category": "Slipway",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "slipway.previewToSide",
          "when": "editorLangId == quarto",
          "group": "navigation"
        },
        {
          "command": "slipway.render",
          "when": "activeWebviewPanelId == 'slipway.preview'",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "slipway.previewToSide",
          "when": "editorLangId == quarto"
        },
        {
          "command": "slipway.preview",
          "when": "editorLangId == quarto"
        }
      ]
    },
    "configuration": {
      "title": "Slipway",
      "properties": {
        "slipway.renderOn": {
          "type": "string",
          "enum": [
            "save",
            "manual"
          ],
          "enumDescriptions": [
            "Re-render open previews when a file in the deck's project is saved.",
            "Render only when the Slipway: Render command is run."
          ],
          "default": "save",
          "description": "When open previews are re-rendered."
        }
      }
    }
  },
  "scripts": {
    "gen-assets": "npm --prefix ../core run gen-assets",
    "prebuild": "npm run gen-assets",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "pretypecheck": "npm run gen-assets",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@slipway/core": "file:../core",
    "@types/node": "^25.8.0",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.25.0",
    "pandoc-wasm": "1.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.6",
    "vscode-uri": "^3.0.8"
  }
}
