{
  "name": "slipway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen-assets": "npm --prefix ../core run gen-assets",
    "predev": "npm run gen-assets",
    "dev": "vite",
    "prebuild": "npm run gen-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
